PORT=4001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Generate once with: openssl rand -base64 32
# Keep this stable and backed up; changing it makes stored merchant voucher codes unreadable.
# Obtain Kenya-specific legal and payment-regulation review before enabling gift-card sales.
GIFT_CARD_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
DB_PATH=data/events.db
UPLOAD_DIR=data/uploads/events
ALLOWED_ORIGINS=https://valorafrica.co.ke,https://valorafricabrand-svg.github.io,http://localhost:8765,http://127.0.0.1:8765
PUBLIC_SITE_URL=https://valorafrica.co.ke
API_DOMAIN=api.valorafrica.co.ke
VALOR_DATA_DIR=/opt/valorafrica-data
# Artist booking deposits turn on when PayHero is configured; set false to pause checkout.
ARTIST_BOOKINGS_PAYMENTS_ENABLED=true

# Configure PayHero in the hosting provider's secret environment variables.
# Create a PayHero account at payhero.co.ke, link your Till/Paybill/bank account,
# and copy the API Username, API Password, and Channel ID from its dashboard.
# Do not put production credentials in this file or commit them to Git.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_CALLBACK_URL=

# NOWPayments ticket checkout uses an USD invoice and this KES-per-USD conversion rate.
# Add the IPN URL as https://<your-api-host>/api/nowpayments/ipn in NOWPayments and here.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_KES_PER_USD=
NOWPAYMENTS_IPN_CALLBACK_URL=

# PayPal Valor Wallet deposits. PayPal does not settle in KES, so deposits are
# converted to USD using PAYPAL_KES_PER_USD. Add a webhook in PayPal pointed at
# https://<your-api-host>/api/paypal/webhook (PAYMENT.CAPTURE.COMPLETED/DENIED).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
PAYPAL_KES_PER_USD=

# Google Pay and Apple Pay ticket checkout through Braintree use a USD merchant account.
# Google Pay requires Braintree setup and a Google merchant ID in production.
# Set Apple Pay to true only after Braintree Apple Pay setup and domain verification.
# Keep all Braintree credentials in the hosting provider's secret environment, never in Git.
BRAINTREE_ENV=sandbox
BRAINTREE_MERCHANT_ID=
BRAINTREE_PUBLIC_KEY=
BRAINTREE_PRIVATE_KEY=
BRAINTREE_MERCHANT_ACCOUNT_ID=
BRAINTREE_GOOGLE_MERCHANT_ID=
BRAINTREE_APPLE_PAY_ENABLED=false
BRAINTREE_KES_PER_USD=

# Wallet sign-in codes are sent through Africa's Talking SMS.
# Choose sandbox while testing; configure production credentials in the host's secret settings.
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Resend sends account verification, booking updates, reminders, and paid/free ticket confirmations with QR attachments.
# Verify the sender domain before production use; keep the API key in the hosting provider's secret settings.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
