PORT=4001
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-long-password
DB_PATH=data/events.db
UPLOAD_DIR=data/uploads/events
ALLOWED_ORIGINS=https://valorafrica.co.ke,https://valorafricabrand-svg.github.io,http://localhost:8765,http://127.0.0.1:8765
PUBLIC_SITE_URL=https://valorafrica.co.ke
API_DOMAIN=api.valorafrica.co.ke
VALOR_DATA_DIR=/opt/valorafrica-data

# Configure Daraja in the hosting provider's secret environment variables.
# Do not put production credentials in this file or commit them to Git.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_ACCOUNT_REFERENCE=ValorAfrica

# Wallet sign-in codes are sent through Africa's Talking SMS.
# Choose sandbox while testing; configure production credentials in the host's secret settings.
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Resend sends account verification and password reset codes, plus paid/free ticket confirmation emails with QR attachments.
# Verify the sender domain before production use; keep the API key in the hosting provider's secret settings.
GOOGLE_CLIENT_ID=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
